generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  FAILED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  EXPIRED
  TRANSFERRED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  tickets Ticket[]

  @@index([role])
  @@index([createdAt])
}

model Event {
  id          String      @id @default(uuid())
  organizerId String
  title       String
  description String?
  venue       String
  address     String?
  startDate   DateTime
  endDate     DateTime
  status      EventStatus @default(PUBLISHED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  ticketTypes TicketType[]
  tickets     Ticket[]

  @@index([organizerId])
  @@index([status])
  @@index([startDate])
}

model TicketType {
  id           String    @id @default(uuid())
  eventId      String
  name         String
  description  String?
  price        Decimal   @db.Decimal(12, 2)
  totalQuantity Int
  quantitySold Int       @default(0)
  salesStart   DateTime?
  salesEnd     DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  tickets    Ticket[]

  @@index([eventId])
  @@index([salesStart])
  @@index([salesEnd])
  @@index([isActive])
}

model Order {
  id            String      @id @default(uuid())
  userId        String
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal     @db.Decimal(12, 2)
  currency      String      @default("USD")
  idempotencyKey String     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  subtotal     Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  tickets    Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
}

model Ticket {
  id            String       @id @default(uuid())
  orderItemId   String
  ticketTypeId  String
  eventId       String
  ownerUserId   String
  status        TicketStatus @default(VALID)
  qrPayload     String
  issuedAt      DateTime     @default(now())
  usedAt        DateTime?
  checkedInBy   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ticketType  TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  owner      User       @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([ticketTypeId])
  @@index([eventId])
  @@index([ownerUserId])
  @@index([status])
}
